ENV=dev
HTTP_PORT=8080
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=cidna_sync_db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
OTP_EXPIRY_MINUTES=5
# Development only: prints OTP to server logs. MUST be false in production.
DEV_LOG_OTP=true
# SMS provider: POST JSON {to,code,message} with optional Bearer token
SMS_WEBHOOK_URL=
SMS_AUTH_TOKEN=
# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
