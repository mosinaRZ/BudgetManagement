# Copy to deployments/.env on the VPS (docker compose reads it from this directory) and edit EVERY value.
# Generate secrets with:  openssl rand -hex 32   (hex only: the Mongo password is embedded in a URI,
# so avoid characters such as @ : / ? # in it).

# DNS name pointing at this VPS (Caddy obtains the HTTPS certificate automatically).
API_DOMAIN=api.example.com

ENV=prod

MONGO_INITDB_ROOT_USERNAME=cidna
MONGO_INITDB_ROOT_PASSWORD=replace-with-openssl-rand-hex-32
MONGO_DB_NAME=cidna_sync_db
# Mongo cache cap in GB; ~25% of RAM is a sensible start on a shared VPS (2 GB RAM -> 0.5).
MONGO_CACHE_GB=0.5

# Four INDEPENDENT server keys, each at least 64 characters in production (openssl rand -hex 48).
# Every key must have its own random value; the server refuses to start if two are equal.
#   JWT_SECRET      signs access tokens only. Rotating it just signs everybody out.
#   PHONE_HASH_KEY  HMAC key of the stored phone identifier. Rotating it detaches accounts from
#                   their phone number until `rehash-phones` is run (see README).
#   OTP_HMAC_KEY    HMAC key of stored one-time-code hashes. Rotating it only voids codes in flight.
#   LOGIN_DECOY_KEY derives the fake KDF salt returned for unknown phone numbers. Rotating it is harmless.
#
# UPGRADING an existing server: set PHONE_HASH_KEY to the value JWT_SECRET has TODAY (so every
# existing account keeps working), then give JWT_SECRET a brand-new random value.
JWT_SECRET=replace-with-openssl-rand-hex-48
PHONE_HASH_KEY=replace-with-another-openssl-rand-hex-48
OTP_HMAC_KEY=replace-with-another-openssl-rand-hex-48
LOGIN_DECOY_KEY=replace-with-another-openssl-rand-hex-48
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
OTP_EXPIRY_MINUTES=5

# Internal Docker subnet; trusted as the reverse-proxy network for client-IP detection.
INTERNAL_SUBNET=172.29.0.0/24

CORS_ALLOWED_ORIGINS=
DEV_LOG_OTP=false

# REQUIRED in production (phone OTP).
# IPPanel Edge API (pattern send). Set the token only on the server, never commit it.
SMS_WEBHOOK_URL=https://edge.ippanel.com/v1/api/send
SMS_AUTH_TOKEN=
# Service line in E.164 format. The pattern must contain a variable named "code".
SMS_FROM_NUMBER=+983000505
SMS_PATTERN_CODE=

# Local MongoDB dumps (./backups). Copy them off the VPS too: a backup on the same disk does not survive losing the server.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Shown on /privacy-policy and /account-deletion (required by Google Play)
